---
import { getImage } from 'astro:assets';
import ogDefault from '../assets/site/og-default.jpg';
import { OG_IMAGE_HEIGHT, OG_IMAGE_WIDTH } from '../lib/consts';
import { siteConfig } from '../lib/config';
import { buildArticleJsonLd, buildHomeJsonLd, isHomePath } from '../lib/json-ld';
import { locales, ogLocales, type Locale } from '../i18n/ui';
import { switchLocalePath } from '../i18n/utils';

interface Props {
  lang: Locale;
  title: string;
  description: string;
  keywords?: string;
  image?: ImageMetadata;
  imageAlt?: string;
  type?: 'website' | 'article';
  publishedTime?: Date;
  modifiedTime?: Date;
  articleCategory?: string;
  headline?: string;
  alternates?: Partial<Record<Locale, string>>;
}

const {
  lang,
  title,
  description,
  keywords,
  image = ogDefault,
  imageAlt,
  type = 'website',
  publishedTime,
  modifiedTime,
  articleCategory,
  headline,
  alternates,
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site ?? siteConfig.url).href;

const ogImage = await getImage({
  src: image,
  width: OG_IMAGE_WIDTH,
  height: OG_IMAGE_HEIGHT,
  format: 'jpeg',
});

const ogImageUrl = new URL(ogImage.src, Astro.site ?? siteConfig.url).href;

const alternateLinks = locales.map((locale) => ({
  locale,
  href: new URL(
    alternates?.[locale] ?? switchLocalePath(Astro.url, locale),
    Astro.site ?? siteConfig.url,
  ).href,
}));

const defaultAlternate = alternateLinks.find((entry) => entry.locale === 'en');

const jsonLd =
  type === 'article' && publishedTime
    ? buildArticleJsonLd({
        lang,
        title: headline ?? title,
        description,
        canonical,
        imageUrl: ogImageUrl,
        publishedTime,
        modifiedTime,
        category: articleCategory,
      })
    : isHomePath(Astro.url.pathname)
      ? buildHomeJsonLd({ lang, description })
      : null;
---

<title>{title}</title>
<meta name="description" content={description} />
{keywords ? <meta name="keywords" content={keywords} /> : null}
<meta name="author" content={siteConfig.author} />
<link rel="canonical" href={canonical} />

{alternateLinks.map(({ locale, href }) => <link rel="alternate" hreflang={locale} href={href} />)}
{
  defaultAlternate ? (
    <link rel="alternate" hreflang="x-default" href={defaultAlternate.href} />
  ) : null
}

<meta property="og:type" content={type} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
<meta property="og:site_name" content={siteConfig.name} />
<meta property="og:locale" content={ogLocales[lang]} />
<meta property="og:image" content={ogImageUrl} />
<meta property="og:image:width" content={String(OG_IMAGE_WIDTH)} />
<meta property="og:image:height" content={String(OG_IMAGE_HEIGHT)} />
<meta property="og:image:alt" content={imageAlt ?? title} />
{
  locales
    .filter((locale) => locale !== lang)
    .map((locale) => <meta property="og:locale:alternate" content={ogLocales[locale]} />)
}
{
  publishedTime ? (
    <meta property="article:published_time" content={publishedTime.toISOString()} />
  ) : null
}
{
  modifiedTime ? (
    <meta property="article:modified_time" content={modifiedTime.toISOString()} />
  ) : null
}

<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={ogImageUrl} />
<meta name="twitter:image:alt" content={imageAlt ?? title} />

{jsonLd ? <script is:inline type="application/ld+json" set:html={JSON.stringify(jsonLd)} /> : null}
