---
import type { Locale } from '../i18n/ui';
import { useTranslations } from '../i18n/utils';
import { blogCategoryLabelKey } from '../lib/blog-categories';
import type { ResolvedPost } from '../lib/content';
import { formatDate, isoDate } from '../lib/utils';

interface Props {
  lang: Locale;
  post: ResolvedPost;
  headingLevel?: 2 | 3;
}

const { lang, post, headingLevel = 2 } = Astro.props;
const t = useTranslations(lang);
const { data } = post.entry;
const HeadingTag = headingLevel === 2 ? 'h2' : 'h3';
---

<article class="group relative border border-edge bg-surface p-4 transition-colors hover:border-accent sm:p-5">
  <div class="mb-2 flex flex-wrap items-center gap-x-3 gap-y-1 font-mono text-xs text-fg-muted">
    <time datetime={isoDate(data.pubDate)}>{formatDate(data.pubDate, lang)}</time>
    <span class="border border-edge bg-surface-raised px-1.5 py-0.5 text-fg-muted">
      {t(blogCategoryLabelKey(data.category))}
    </span>
    {
      post.isFallback ? (
        <span class="border border-pin px-1.5 py-0.5 text-pin" title={t('common.fallbackNotice')}>
          EN
        </span>
      ) : null
    }
  </div>

  <HeadingTag class="text-xl leading-snug">
    <a href={post.href} class="after:absolute after:inset-0 group-hover:text-accent">
      {data.title}
    </a>
  </HeadingTag>

  <p class="mt-2 text-sm text-fg-muted">{data.description}</p>

  <p class="mt-3 font-mono text-xs text-accent" aria-hidden="true">
    {t('blog.readMore')}
    <span> -&gt;</span>
  </p>
</article>
