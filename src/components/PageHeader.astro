---
import { Image } from 'astro:assets';
import desk from '../assets/site/desk.jpg';
import type { Locale } from '../i18n/ui';
import { useTranslations } from '../i18n/utils';

type Section = 'projects' | 'blog' | 'travels' | 'contact';

interface Props {
  lang: Locale;
  title: string;
  description?: string;
  section?: Section;
}

const { lang, title, description, section } = Astro.props;
const t = useTranslations(lang);

const cropPositions: Record<Section, string> = {
  projects: '8% 50%',
  travels: '33% 45%',
  blog: '63% 72%',
  contact: '90% 40%',
};

const crop = section
  ? {
      position: cropPositions[section],
      alt: t(`illustration.desk.${section}`),
    }
  : undefined;
---

<header class="mb-8 border border-l-8 border-edge border-l-accent bg-surface p-4 sm:mb-10 sm:p-5">
  <div class="flex flex-col gap-4 sm:flex-row sm:items-center sm:gap-5">
    {
      crop ? (
        <div class="w-full shrink-0 overflow-hidden border-2 border-edge sm:w-40">
          <Image
            src={desk}
            alt={crop.alt}
            widths={[320, 640]}
            sizes="(min-width: 640px) 10rem, 100vw"
            class="aspect-[5/3] w-full object-cover sm:aspect-square sm:h-28 sm:w-40"
            style={`object-position: ${crop.position}`}
            loading="eager"
          />
        </div>
      ) : null
    }

    <div class="min-w-0">
      {
        section ? (
          <p class="font-mono text-xs tracking-widest text-fg-muted uppercase">~/{section}</p>
        ) : null
      }
      <h1 class="mt-1 text-3xl leading-tight sm:text-4xl">
        <span class="mr-2 text-accent" aria-hidden="true">#</span>
        {title}
      </h1>
      {description ? <p class="mt-2 max-w-2xl text-fg-muted">{description}</p> : null}
    </div>
  </div>
</header>
