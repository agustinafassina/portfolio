---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getLangFromUrl, localizedPath, useTranslations } from '../i18n/utils';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<BaseLayout lang={lang} title={t('common.notFound')}>
  <div class="py-16 text-center">
    <p class="font-mono text-6xl text-accent">404</p>
    <h1 class="mt-4 text-2xl">{t('common.notFound')}</h1>
    <p class="mt-6">
      <a
        href={localizedPath(lang)}
        class="border-2 border-edge px-4 py-2 font-mono text-sm hover:border-accent hover:text-accent"
      >
        {t('nav.home')}
      </a>
    </p>
  </div>
</BaseLayout>
