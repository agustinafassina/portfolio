---
import { Image } from 'astro:assets';
import avatar from '../../assets/profile/avatar.jpg';
import PageHeader from '../../components/PageHeader.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import type { Locale } from '../../i18n/ui';
import { localeStaticPaths, useTranslations } from '../../i18n/utils';
import { siteConfig, socialLinks } from '../../lib/config';

export const getStaticPaths = localeStaticPaths;

const { lang } = Astro.props as { lang: Locale };
const t = useTranslations(lang);

const fieldClass =
  'w-full border-2 border-edge bg-surface-raised px-3 py-2 text-sm text-fg placeholder:text-fg-muted/70 focus:border-accent focus:outline-none';
const labelClass = 'mb-1.5 block font-mono text-xs tracking-wide text-fg-muted uppercase';
---

<BaseLayout lang={lang} title={t('contact.title')} description={t('contact.description')}>
  <PageHeader
    lang={lang}
    title={t('contact.title')}
    description={t('contact.description')}
    section="contact"
  />

  <div class="grid gap-10 md:grid-cols-[1.4fr_1fr]">
    <form
      action={siteConfig.formspreeEndpoint}
      method="POST"
      class="space-y-4 border-2 border-edge bg-surface p-5"
    >
      <p class="hidden" aria-hidden="true">
        <label for="gotcha">Leave this empty</label>
        <input type="text" id="gotcha" name="_gotcha" tabindex="-1" autocomplete="off" />
      </p>

      <div>
        <label class={labelClass} for="name">{t('contact.formName')}</label>
        <input
          class={fieldClass}
          type="text"
          id="name"
          name="name"
          required
          maxlength="100"
          autocomplete="name"
          placeholder={t('contact.formNamePlaceholder')}
        />
      </div>

      <div>
        <label class={labelClass} for="email">{t('contact.formEmail')}</label>
        <input
          class={fieldClass}
          type="email"
          id="email"
          name="email"
          required
          maxlength="254"
          autocomplete="email"
          placeholder={t('contact.formEmailPlaceholder')}
        />
      </div>

      <div>
        <label class={labelClass} for="message">{t('contact.formMessage')}</label>
        <textarea
          class={fieldClass}
          id="message"
          name="message"
          rows="6"
          required
          maxlength="5000"
          placeholder={t('contact.formMessagePlaceholder')}></textarea>
      </div>

      <input type="hidden" name="_language" value={lang} />

      <button
        type="submit"
        class="border-2 border-accent bg-accent px-4 py-2 font-mono text-sm text-accent-contrast hover:border-accent-hover hover:bg-accent-hover"
      >
        {t('contact.formSend')}
      </button>
    </form>

    <aside class="space-y-6">
      <div class="flex items-center gap-3">
        <Image
          src={avatar}
          alt={siteConfig.author}
          widths={[80, 160]}
          sizes="4rem"
          class="size-14 rounded-full border-2 border-accent object-cover"
          loading="lazy"
        />
        <p class="font-mono text-sm font-bold">{siteConfig.author}</p>
      </div>

      <div>
        <p class="text-sm text-fg-muted">{t('contact.orEmail')}</p>
        <a
          href={`mailto:${siteConfig.email}`}
          class="link-underline font-mono text-sm break-all text-accent"
        >
          {siteConfig.email}
        </a>
      </div>

      <div>
        <p class="mb-2 font-mono text-xs tracking-widest text-fg-muted uppercase">
          {t('contact.socials')}
        </p>
        <ul class="space-y-1.5">
          {
            socialLinks.map((link) => (
              <li>
                <a
                  href={link.url}
                  target="_blank"
                  rel="me noopener noreferrer"
                  class="text-sm text-fg-muted hover:text-accent"
                >
                  {link.label}
                  <span aria-hidden="true"> -&gt;</span>
                </a>
              </li>
            ))
          }
        </ul>
      </div>
    </aside>
  </div>
</BaseLayout>
