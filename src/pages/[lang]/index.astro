---
import { Image } from 'astro:assets';
import avatar from '../../assets/profile/avatar.jpg';
import travelsBanner from '../../assets/site/travels-banner.png';
import BlogCard from '../../components/BlogCard.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import type { Locale } from '../../i18n/ui';
import { localeStaticPaths, localizedPath, useTranslations } from '../../i18n/utils';
import { HOME_FEATURED_PROJECTS_LIMIT, HOME_POSTS_LIMIT, HOME_TRAVELS_PREVIEW_LIMIT, SKILLS_MAP_URL } from '../../lib/consts';
import { getFeaturedProjects, getPosts, getTravels } from '../../lib/content';
import { siteConfig } from '../../lib/config';
import { flagDataUri } from '../../lib/flags';

export const getStaticPaths = localeStaticPaths;

const { lang } = Astro.props as { lang: Locale };
const t = useTranslations(lang);

const projects = await getFeaturedProjects(lang, HOME_FEATURED_PROJECTS_LIMIT);
const posts = (await getPosts(lang)).slice(0, HOME_POSTS_LIMIT);
const travels = await getTravels(lang);
const travelPreview = travels.slice(0, HOME_TRAVELS_PREVIEW_LIMIT);

const skillDomains = [
  'home.skillsDomain.cloud',
  'home.skillsDomain.iac',
  'home.skillsDomain.cicd',
  'home.skillsDomain.security',
  'home.skillsDomain.dotnet',
  'home.skillsDomain.data',
] as const;
---

<BaseLayout lang={lang} title={siteConfig.name} description={t('site.description')} wide>
  <section class="lamp-glow border-b-2 border-edge">
    <div class="mx-auto w-full max-w-5xl px-4 py-12 sm:px-6 sm:py-16">
      <div class="grid items-center gap-8 lg:grid-cols-[1fr_auto]">
        <div class="home-rise">
          <p class="font-mono text-sm text-fg-muted">{t('home.greeting')}</p>
          <h1 class="mt-1 text-3xl leading-tight font-bold tracking-tight sm:text-4xl">
            {siteConfig.author}
          </h1>
          <p class="mt-3 font-mono text-base text-accent sm:text-lg">{t('home.role')}</p>

          <p class="mt-5 max-w-2xl text-fg-muted">{t('home.pitch')}</p>

          <div class="mt-7 flex flex-wrap gap-3">
            <a
              href={localizedPath(lang, 'projects')}
              class="border-2 border-accent bg-accent px-4 py-2 font-mono text-sm text-accent-contrast hover:bg-accent-hover hover:border-accent-hover"
            >
              {t('home.ctaProjects')}
            </a>
            <a
              href={localizedPath(lang, 'contact')}
              class="border-2 border-edge px-4 py-2 font-mono text-sm hover:border-accent hover:text-accent"
            >
              {t('home.ctaContact')}
            </a>
          </div>
        </div>

        <div class="home-rise home-rise-delay-1 overflow-hidden border-2 border-edge lg:w-72 xl:w-80">
          <Image
            src={avatar}
            alt={siteConfig.author}
            widths={[320, 640, 960]}
            sizes="(min-width: 1024px) 20rem, 80vw"
            class="aspect-[4/5] w-full object-cover object-top"
            loading="eager"
          />
        </div>
      </div>
    </div>
  </section>

  <div class="mx-auto w-full max-w-5xl px-4 pt-14 pb-2 sm:px-6">
    <section>
      <div class="mb-6">
        <h2 class="text-2xl">
          <span class="mr-2 text-accent" aria-hidden="true">##</span>
          {t('home.skillsTitle')}
        </h2>
      </div>

      <div class="border border-edge bg-surface p-5 sm:p-6">
        <p class="max-w-2xl text-fg-muted">{t('home.skillsSummary')}</p>

        <ul class="mt-5 flex flex-wrap gap-2" aria-label={t('home.skillsTitle')}>
          {
            skillDomains.map((key) => (
              <li class="border border-edge bg-surface-raised px-2.5 py-1 font-mono text-xs text-fg transition-colors hover:border-accent hover:text-accent">
                {t(key)}
              </li>
            ))
          }
        </ul>

        <div class="mt-6">
          <a
            href={SKILLS_MAP_URL}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex border border-edge px-4 py-2 font-mono text-sm hover:border-accent hover:text-accent"
          >
            {t('home.skillsMap')}
            <span aria-hidden="true" class="ml-2">
              -&gt;
            </span>
          </a>
        </div>
      </div>
    </section>
  </div>

  <section class="mt-20 border-y border-edge bg-surface sm:mt-24">
    <div class="mx-auto w-full max-w-5xl px-4 py-14 sm:px-6 sm:py-16">
      <div class="mb-6 flex items-baseline justify-between gap-4">
        <h2 class="text-2xl">
          <span class="mr-2 text-accent" aria-hidden="true">##</span>
          {t('home.latestProjects')}
        </h2>
        <a
          href={localizedPath(lang, 'projects')}
          class="shrink-0 font-mono text-sm text-accent hover:text-accent-hover"
        >
          {t('home.viewAllProjects')}
          <span aria-hidden="true"> -&gt;</span>
        </a>
      </div>

      {
        projects.length > 0 ? (
          <div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
            {projects.map((project) => (
              <ProjectCard lang={lang} project={project} headingLevel={3} />
            ))}
          </div>
        ) : (
          <p class="text-fg-muted">{t('projects.empty')}</p>
        )
      }
    </div>
  </section>

  <div class="mx-auto w-full max-w-5xl px-4 py-14 sm:px-6 sm:py-16">
    <section>
      <div class="mb-6 flex items-baseline justify-between gap-4">
        <h2 class="text-2xl">
          <span class="mr-2 text-accent" aria-hidden="true">##</span>
          {t('home.latestPosts')}
        </h2>
        <a
          href={localizedPath(lang, 'blog')}
          class="shrink-0 font-mono text-sm text-accent hover:text-accent-hover"
        >
          {t('home.viewAllPosts')}
          <span aria-hidden="true"> -&gt;</span>
        </a>
      </div>

      {
        posts.length > 0 ? (
          <div class="grid items-stretch gap-5 sm:grid-cols-2 lg:grid-cols-3">
            {posts.map((post) => (
              <BlogCard lang={lang} post={post} headingLevel={3} />
            ))}
          </div>
        ) : (
          <p class="text-fg-muted">{t('blog.empty')}</p>
        )
      }
    </section>
  </div>

  {
    travels.length > 0 ? (
      <section class="border-y border-edge bg-surface">
        <div class="mx-auto w-full max-w-5xl px-4 py-14 sm:px-6 sm:py-16">
          <div class="mb-6 flex items-baseline justify-between gap-4">
            <h2 class="text-2xl">
              <span class="mr-2 text-accent" aria-hidden="true">
                ##
              </span>
              {t('home.travelsTitle')}
            </h2>
            <a
              href={localizedPath(lang, 'travels')}
              class="shrink-0 font-mono text-sm text-accent hover:text-accent-hover"
            >
              {t('home.viewAllTravels')}
              <span aria-hidden="true"> -&gt;</span>
            </a>
          </div>

          <div class="overflow-hidden border border-edge bg-surface-raised">
            <Image
              src={travelsBanner}
              alt={t('home.travelsBannerAlt')}
              widths={[640, 1024, 1536]}
              sizes="(min-width: 1024px) 64rem, 92vw"
              class="aspect-[3/1] w-full object-cover object-center sm:aspect-[3.5/1]"
              loading="lazy"
            />
            <div class="p-5 sm:p-6">
              <p class="max-w-2xl text-fg-muted">{t('home.travelsSummary')}</p>
              <p class="mt-4 font-mono text-xs tracking-widest text-fg-muted uppercase">
                {t('travels.countries')}
                <span class="ml-2 text-accent">{travels.length}</span>
              </p>

              <ul class="mt-4 flex flex-wrap gap-2">
                {travelPreview.map((travel) => (
                  <li class="inline-flex items-center gap-2 border border-edge bg-surface px-2.5 py-1 font-mono text-xs text-fg transition-colors hover:border-accent hover:text-accent">
                    <img
                      src={flagDataUri(travel.countryCode)}
                      alt=""
                      width="18"
                      height="14"
                      class="border border-edge"
                      loading="lazy"
                    />
                    {travel.country}
                  </li>
                ))}
                {travels.length > travelPreview.length ? (
                  <li class="inline-flex items-center px-2.5 py-1 font-mono text-xs text-fg-muted">
                    +{travels.length - travelPreview.length}
                  </li>
                ) : null}
              </ul>
            </div>
          </div>
        </div>
      </section>
    ) : null
  }

  <div class="mx-auto w-full max-w-5xl px-4 py-14 sm:px-6 sm:py-16">
    <section>
      <div class="mb-6">
        <h2 class="text-2xl">
          <span class="mr-2 text-accent" aria-hidden="true">##</span>
          {t('home.contactCtaTitle')}
        </h2>
      </div>

      <div class="border border-l-8 border-edge border-l-accent bg-surface p-5 transition-transform hover:-translate-y-0.5 sm:p-6">
        <p class="max-w-2xl text-fg-muted">{t('home.contactCtaBody')}</p>
        <div class="mt-6">
          <a
            href={localizedPath(lang, 'contact')}
            class="inline-flex border-2 border-accent bg-accent px-4 py-2 font-mono text-sm text-accent-contrast hover:border-accent-hover hover:bg-accent-hover"
          >
            {t('home.ctaContact')}
            <span aria-hidden="true" class="ml-2">
              -&gt;
            </span>
          </a>
        </div>
      </div>
    </section>
  </div>
</BaseLayout>
