---
import { Image } from 'astro:assets';
import BaseLayout from './BaseLayout.astro';
import type { Locale } from '../i18n/ui';
import { localizedPath, useTranslations } from '../i18n/utils';
import type { ResolvedPost } from '../lib/content';
import { formatDate, isoDate, readingTime } from '../lib/utils';

interface Props {
  lang: Locale;
  post: ResolvedPost;
  alternates: Partial<Record<Locale, string>>;
}

const { lang, post, alternates } = Astro.props;
const t = useTranslations(lang);
const { data, body } = post.entry;
---

<BaseLayout
  lang={lang}
  title={data.title}
  description={data.description}
  image={data.cover}
  imageAlt={data.coverAlt}
  type="article"
  publishedTime={data.pubDate}
  modifiedTime={data.updatedDate}
  alternates={alternates}
>
  <article class="mx-auto max-w-3xl">
    <a
      href={localizedPath(lang, 'blog')}
      class="font-mono text-xs text-fg-muted hover:text-accent"
    >
      <span aria-hidden="true">&lt;-</span>
      {t('blog.backToList')}
    </a>

    <header class="mt-6 border-b-2 border-edge pb-6">
      <div class="mb-3 flex flex-wrap items-center gap-x-3 gap-y-1 font-mono text-xs text-fg-muted">
        <span class="border border-edge bg-surface-raised px-1.5 py-0.5">{data.category}</span>
        <time datetime={isoDate(data.pubDate)}>
          {t('blog.publishedOn')} {formatDate(data.pubDate, lang)}
        </time>
        {
          data.updatedDate ? (
            <time datetime={isoDate(data.updatedDate)}>
              {t('blog.updatedOn')} {formatDate(data.updatedDate, lang)}
            </time>
          ) : null
        }
        {body ? <span>{readingTime(body, lang)}</span> : null}
      </div>

      <h1 class="text-3xl leading-tight sm:text-4xl">{data.title}</h1>
      <p class="mt-3 text-lg text-fg-muted">{data.description}</p>

      {
        post.isFallback ? (
          <p class="mt-4 border-2 border-l-8 border-edge border-l-pin bg-surface px-3 py-2 font-mono text-xs text-fg-muted">
            {t('common.fallbackNotice')}
          </p>
        ) : null
      }
    </header>

    {
      data.cover ? (
        <Image
          src={data.cover}
          alt={data.coverAlt ?? data.title}
          widths={[640, 1024]}
          sizes="(min-width: 768px) 48rem, 92vw"
          class="mt-8 w-full border-2 border-edge"
          loading="eager"
        />
      ) : null
    }

    <div class="prose-desk mt-10">
      <slot />
    </div>

    <footer class="mt-12 border-t-2 border-edge pt-6">
      <a
        href={localizedPath(lang, 'blog')}
        class="font-mono text-xs text-accent hover:text-accent-hover"
      >
        <span aria-hidden="true">&lt;-</span>
        {t('blog.backToList')}
      </a>
    </footer>
  </article>
</BaseLayout>
