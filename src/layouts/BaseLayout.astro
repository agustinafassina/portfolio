---
import '@fontsource-variable/inter';
import '@fontsource-variable/jetbrains-mono';
import '../styles/global.css';

import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import SEO from '../components/SEO.astro';
import type { Locale } from '../i18n/ui';
import { useTranslations, localizedPath } from '../i18n/utils';
import { siteConfig } from '../lib/config';

interface Props {
  lang: Locale;
  title: string;
  description?: string;
  keywords?: string;
  image?: ImageMetadata;
  imageAlt?: string;
  type?: 'website' | 'article';
  publishedTime?: Date;
  modifiedTime?: Date;
  articleCategory?: string;
  headline?: string;
  alternates?: Partial<Record<Locale, string>>;
  wide?: boolean;
}

const {
  lang,
  title,
  description,
  keywords,
  image,
  imageAlt,
  type,
  publishedTime,
  modifiedTime,
  articleCategory,
  headline,
  alternates,
  wide = false,
} = Astro.props;

const t = useTranslations(lang);

const pageTitle = title === siteConfig.name ? title : `${title} · ${siteConfig.name}`;
const pageDescription = description ?? t('site.description');
const pageKeywords = keywords ?? t('site.keywords');
---

<!doctype html>
<html lang={lang} class="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link
      rel="alternate"
      type="application/rss+xml"
      title={`${siteConfig.name} · ${t('nav.blog')}`}
      href={localizedPath(lang, 'rss.xml')}
    />

    <SEO
      lang={lang}
      title={pageTitle}
      description={pageDescription}
      keywords={pageKeywords}
      image={image}
      imageAlt={imageAlt}
      type={type}
      publishedTime={publishedTime}
      modifiedTime={modifiedTime}
      articleCategory={articleCategory}
      headline={headline}
      alternates={alternates}
    />

    <script is:inline>
      (() => {
        let theme = 'dark';
        try {
          const stored = localStorage.getItem('theme');
          if (stored === 'light' || stored === 'dark') theme = stored;
        } catch {
          // localStorage may be unavailable in private browsing.
        }
        document.documentElement.classList.toggle('dark', theme === 'dark');
        document.documentElement.dataset.theme = theme;
      })();
    </script>
  </head>

  <body class="flex min-h-screen flex-col">
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:absolute focus:top-3 focus:left-3 focus:z-50 focus:border-2 focus:border-accent focus:bg-surface focus:px-4 focus:py-2 focus:font-mono focus:text-sm"
    >
      {t('common.skipToContent')}
    </a>

    <Header lang={lang} alternates={alternates} />

    <main id="main" class="flex-1">
      <div class={wide ? '' : 'mx-auto w-full max-w-5xl px-4 py-12 sm:px-6 sm:py-16'}>
        <slot />
      </div>
    </main>

    <Footer lang={lang} />
  </body>
</html>
